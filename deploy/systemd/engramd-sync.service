[Unit]
Description=Engram Sync Relay (engramd-sync)
Documentation=https://engram.ellmstack.dev
After=network.target

[Service]
Type=simple
User=engram-sync
Group=engram-sync
# Bind loopback-only: TLS terminates at Caddy (sync.engram.ellmstack.dev).
ExecStart=/usr/local/bin/engramd-sync --data-dir /var/lib/engram-sync --bind 127.0.0.1:8788
Environment=RUST_LOG=info
# Optional env file: SYNC_API_KEYS (REQUIRED — non-loopback auth; see main.rs)
EnvironmentFile=-/etc/engram-sync/engramd-sync.env
Restart=always
RestartSec=5

# ── Sandboxing ──────────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/engram-sync
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
