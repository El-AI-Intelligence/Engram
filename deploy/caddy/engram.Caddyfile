# ─────────────────────────────────────────────────────────────────────────────
# engram.ellmstack.dev — Engram Memory Vault
#
# Caddy v2 site config. Import from the main Caddyfile with:
#
#     import /etc/caddy/engram.Caddyfile
#
# Architecture:
#   browser → Caddy :443 (automatic TLS via Let's Encrypt)
#     ├── /              → static landing page (/srv/engram/landing)   [public]
#     ├── /app           → static vault UI SPA (/srv/engram/vault)     [public shell]
#     └── API paths      → reverse_proxy 127.0.0.1:8787 (engramd)      [basic_auth]
#
# Routing note: the API proxy MUST be a `handle` block, not a bare
# reverse_proxy directive. A bare reverse_proxy compiles AFTER the catch-all
# `handle {}` in Caddy's handler chain, so the landing file_server would
# swallow every API request with a 404 before the proxy ever runs.
#
# Required environment variables (Caddy substitutes these at config-load time;
# set them via a systemd override for the caddy service, e.g.
# /etc/systemd/system/caddy.service.d/engram.conf with Environment= lines):
#
#   ENGRAMD_API_KEY      — API key engramd requires (crates/engramd/src/auth.rs).
#                          Caddy injects it as `Authorization: Bearer <key>` on
#                          proxied requests so the SPA's same-origin fetches
#                          pass engramd's auth middleware. Must match the value
#                          in /etc/engram/engramd.env.
#   ENGRAM_UI_USER       — username for HTTP basic auth (vault UI + API).
#   ENGRAM_UI_PASS_HASH  — bcrypt hash of the basic-auth password.
#                          Generate with: caddy hash-password --plaintext <pw>
#
# Note on URL layout: the vault SPA calls fetch(API + path) with API = ''
# (ui/engram-vault/js/main.js:5) and root-absolute paths like '/health', so
# API requests resolve to the ORIGIN ROOT, not under /app. The API matchers
# below are therefore root paths.
# ─────────────────────────────────────────────────────────────────────────────

engram.ellmstack.dev {
	encode zstd gzip

	# ── Authentication ──────────────────────────────────────────────────────
	# API paths sit behind HTTP basic auth; the SPA shell at /app is PUBLIC
	# and shows a branded login screen that sends explicit Authorization
	# headers (the popup challenge is stripped from API 401s below).
	# Path prefixes mirror engramd's routers (crates/engramd/src/routes/*.rs).
	@protected path /health /memories* /context* /consolidate* /analytics* /config /export /import /ws* /annotations* /searches* /privacy* /sync* /teams* /digest*
	basic_auth @protected {
		{$ENGRAM_UI_USER} {$ENGRAM_UI_PASS_HASH}
	}

	# ── Sign out of the vault UI ─────────────────────────────────────────────
	# HTTP basic auth has no server-side session: the browser caches the
	# password and re-sends it on every request. Answering 401 with a fresh
	# challenge for the SAME realm makes Chrome/Firefox discard the cached
	# credentials, so the next /app load prompts again (Safari may keep the
	# cache; closing the tab always works). The SPA calls this route when the
	# user clicks "Sign out" in Settings → Account & Sync.
	handle /auth/ui-logout {
		header WWW-Authenticate `Basic realm="restricted"`
		respond "Signed out of the vault." 401
	}

	# ── SSE: real-time context stream (must precede @api: both match) ────────
	# /context/stream is Server-Sent Events (crates/engramd/src/routes/context.rs).
	# flush_interval -1 disables response buffering so events arrive immediately.
	handle /context/stream {
		reverse_proxy 127.0.0.1:8787 {
			header_up Authorization "Bearer {$ENGRAMD_API_KEY}"
			flush_interval -1
		}
	}

	# ── JSON REST API → engramd on 127.0.0.1:8787 ──────────────────────────
	# (/ws/events upgrades to WebSocket transparently through this proxy.)
	@api path /health /memories* /context* /consolidate* /analytics* /config /export /import /ws* /annotations* /searches* /privacy* /sync* /teams* /digest*
	handle @api {
		reverse_proxy 127.0.0.1:8787 {
			header_up Authorization "Bearer {$ENGRAMD_API_KEY}"
		}
	}

	# Strip the Basic challenge from API-path 401s so the browser never shows the
	# native auth popup — the SPA login screen sends explicit Authorization headers.
	# Must live in handle_errors: basic_auth's 401 is written through Caddy's
	# ERROR path, which bypasses the `header` directive's write-time wrapper
	# (verified against Caddy 2.11 on the box — `header @api -WWW-Authenticate`
	# does NOT strip basic_auth's own 401s), while handle_errors intercepts the
	# error response before it is written, where the strip does apply.
	# /auth/ui-logout's 401 is a `respond`, i.e. a normal handler response, not
	# an error — it never enters handle_errors and keeps its deliberate challenge.
	handle_errors 401 {
		@api_err path /health /memories* /context* /consolidate* /analytics* /config /export /import /ws* /annotations* /searches* /privacy* /sync* /teams* /digest*
		handle @api_err {
			header -WWW-Authenticate
			respond "unauthorized" 401
		}
	}

	# ── Vault UI SPA at /app ────────────────────────────────────────────────
	# No-build static SPA with hash routing (#/, #/memories, ...), so the only
	# fallback needed is index.html; no history-API rewrite complexity.
	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/engram/vault
		try_files {path} /index.html
		file_server
		# The SPA is a no-build static bundle; without this, browsers
		# heuristic-cache main.js and users keep seeing stale UIs after
		# deploys (hit repeatedly). Always revalidate.
		header Cache-Control "no-cache"
	}

	# ── Public landing page ─────────────────────────────────────────────────
	handle {
		root * /srv/engram/landing
		file_server
		# Landing has no build-hash fingerprinting either; heuristic caching
		# served stale pre-grey-flip HTML (old CSP without the sync relay)
		# long after deploys. Always revalidate, same as the SPA above.
		header Cache-Control "no-cache"
	}

	# Site-level (matcher-less) header block: applies to ALL paths. (A `header /`
	# directive only matches the literal root path — empirically /app never got
	# the CSP until it moved here.) script-src 'wasm-unsafe-eval' allows
	# WebAssembly.instantiate for the vendored hash-wasm Argon2id (browser
	# unlock view); connect-src lists the sync relay the browser calls
	# directly. Hosted-shell caveat: custom-relay users are CSP-bound to the
	# relays listed here.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self' https://sync.ellmstack.dev http://127.0.0.1:* http://localhost:*; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
	}
}
