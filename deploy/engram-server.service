[Unit]
Description=Engram Memory Vault — Rust engramd server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/engram
ExecStart=/root/engram/engramd --vault /root/engram/vault --bind 127.0.0.1:8787
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=engramd

[Install]
WantedBy=multi-user.target
